# =====================================================================
#  SaveEats Backend - ตัวอย่างไฟล์ Environment
#  วิธีใช้ : ก็อปไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง
#           คำสั่ง (Windows)  :  copy .env.example .env
#           คำสั่ง (Mac/Linux):  cp .env.example .env
#
#  *** ห้าม commit ไฟล์ .env ขึ้น GitHub เด็ดขาด ***
# =====================================================================

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database (ค่าเริ่มต้นของ XAMPP) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saveeats
# ต่อฐานข้อมูลแบบเข้ารหัสหรือไม่
#   XAMPP ในเครื่อง -> false (หรือไม่ต้องใส่บรรทัดนี้)
#   ฐานข้อมูลบนคลาวด์ เช่น Aiven -> true (เขาบังคับ)
DB_SSL=false
# เขตเวลาของฝั่งฐานข้อมูล (คนละตัวกับ TZ ข้างล่าง)
# คุมค่า created_at และคำสั่ง NOW() ในทุก query
# ปล่อยเป็น +07:00 ได้ทั้งตอนรันในเครื่องและตอนขึ้นคลาวด์
DB_TIMEZONE=+07:00
# ใบรับรองของผู้ให้บริการฐานข้อมูล (ไม่ใส่ก็ใช้งานได้)
#   ไม่ใส่ = ยังเข้ารหัสอยู่ แต่ไม่ตรวจว่าปลายทางเป็นตัวจริง
#   ใส่    = ปลอดภัยเต็มที่ ใส่ได้ทั้งเนื้อใบรับรองทั้งก้อน
#            หรือใส่เป็นที่อยู่ไฟล์ เช่น C:\SaveEats\backend\ca.pem
DB_SSL_CA=

# ---- JWT ----
# เปลี่ยนเป็นข้อความสุ่มยาว ๆ ของตัวเอง ห้ามใช้ค่านี้ตอนขึ้นจริง
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- URL ที่ใช้ประกอบ path ของรูปภาพที่อัปโหลด ----
# ตอนทดสอบบนมือถือให้เปลี่ยน localhost เป็น IP ของคอมในวง Wi-Fi
#   เช่น http://192.168.1.35:3000
# ตอนขึ้นคลาวด์ให้ใส่ที่อยู่จริงของ Backend
#   เช่น https://saveeats-api.onrender.com
# *** ห้ามมีเครื่องหมาย / ปิดท้าย ***
PUBLIC_BASE_URL=http://localhost:3000

# ---- เขตเวลา ----
# ไม่ต้องใส่ตอนรันในเครื่อง เพราะ Windows ตั้งเป็นเวลาไทยอยู่แล้ว
# แต่เซิร์ฟเวอร์บนคลาวด์ใช้เวลา UTC ซึ่งช้ากว่าไทย 7 ชั่วโมง
# ถ้าไม่ตั้ง เวลาหมดอายุของคิวและการเช็คเวลารับอาหารจะเพี้ยนทั้งระบบ
TZ=Asia/Bangkok

# ---- กติกาของระบบ (ปรับได้) ----
# หลังหมดเวลารับอาหารแล้ว ให้การจองหมดอายุภายในกี่นาที
RESERVATION_GRACE_MINUTES=30
# จำนวนสูงสุดที่ลูกค้า 1 คนจองได้ต่อ 1 โพสต์
MAX_QUANTITY_PER_RESERVATION=5
# รัศมีค้นหาร้านใกล้เคียงเริ่มต้น (กิโลเมตร)
DEFAULT_SEARCH_RADIUS_KM=5

# =====================================================================
#  ส่งอีเมล - ใช้กับหน้า "ลืมรหัสผ่าน"
# =====================================================================
#  *** ไม่ตั้งค่าก็ใช้งานได้ ***
#  ถ้าเว้น SMTP_USER ไว้ ระบบจะไม่ส่งอีเมลจริง แต่จะพิมพ์ลิงก์
#  ออกมาที่หน้าต่าง cmd ของ backend แทน ซึ่งใช้ทดสอบและสาธิตได้เลย
#
#  วิธีเปิดใช้จริงด้วย Gmail
#    1. เปิด 2-Step Verification ในบัญชี Google
#    2. สร้าง App Password ที่ https://myaccount.google.com/apppasswords
#    3. เอารหัส 16 ตัวที่ได้มาใส่ที่ SMTP_PASS (ไม่ใช่รหัสเข้า Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SaveEats <no-reply@saveeats.local>
# ลิงก์ตั้งรหัสผ่านใหม่หมดอายุในกี่นาที
RESET_TOKEN_MINUTES=60
