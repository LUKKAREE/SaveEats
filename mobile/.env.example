# ---- Google Maps API Key ----
# ใช้กับหน้าแผนที่บน Android เท่านั้น (iOS ใช้ Apple Maps ไม่ต้องมีคีย์)
#
# ถ้าปล่อยว่างไว้ แอปยังเปิดได้ปกติ แค่หน้าแผนที่จะเป็นจอเทา
# ส่วนรายการร้านที่อยู่ใต้แผนที่ยังใช้งานได้
#
# วิธีขอคีย์ทีละขั้น : ดู docs/02_วิธีติดตั้งและรัน.txt หัวข้อ 5
GOOGLE_MAPS_API_KEY=
