#  *** ชื่อต้องขึ้นต้นด้วย VITE_ เท่านั้น ไม่งั้น Vite จะไม่ฝังค่าลงไฟล์ที่ build ***
# =====================================================================

# ที่อยู่ของ Backend  ห้ามมี / ปิดท้าย
VITE_API_URL=http://localhost:3000
